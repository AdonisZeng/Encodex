<ui:FluentWindow x:Class="Encodex.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Encodex - 编码转换工具"
        Icon="pack://application:,,,/Ico/encodex.ico"
        ExtendsContentIntoTitleBar="True"
        Height="650" Width="950"
        WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Custom title bar: app icon + name on the left, window buttons on the right.
             Icon uses a PNG: WPF ImageSource cannot decode .ico files (Window.Icon is
             the only .ico-capable path). -->
        <ui:TitleBar Grid.Row="0"
                     Title="Encodex - 编码转换工具"
                     Icon="pack://application:,,,/Ico/encodex.png"
                     ShowMinimize="True" ShowMaximize="True" ShowClose="True"
                     CloseWindowByDoubleClickOnIcon="True"/>

        <Grid Grid.Row="1" Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Status Bar -->
            <TextBlock Grid.Row="0" Text="{Binding StatusText}" Margin="0,0,0,8"
                       FontSize="14" Opacity="0.8"/>

            <!-- Tab Control -->
            <TabControl Grid.Row="1" SelectedIndex="{Binding SelectedTabIndex}">

                <!-- Tab 1: Configuration -->
                <TabItem Header="① 配置">
                    <!-- ScrollViewer: the form can exceed the window height (small windows / high DPI).
                         Right padding keeps the scrollbar clear of the form controls. -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="8,8,4,8" Padding="0,0,12,0">
                    <StackPanel VerticalAlignment="Top">
                        <TextBlock Text="源文件夹" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <DockPanel Margin="0,0,0,16">
                            <Button DockPanel.Dock="Right" Content="浏览" Margin="8,0,0,0"
                                    Command="{Binding BrowseFolderCommand}" Padding="16,4"/>
                            <ui:TextBox Text="{Binding SourceFolderPath, UpdateSourceTrigger=PropertyChanged}"
                                        IsReadOnly="True"/>
                        </DockPanel>

                        <TextBlock Text="目标编码" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <ComboBox ItemsSource="{Binding AvailableEncodings}"
                                  SelectedItem="{Binding SelectedEncoding}"
                                  DisplayMemberPath="DisplayName"
                                  Margin="0,0,0,16" Padding="8"/>

                        <TextBlock Text="文件扩展名" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <TextBlock Text="按分类展开并勾选需要处理的扩展名，取消勾选即可停用（可随时重新勾选）"
                                   FontSize="11" Opacity="0.6" Margin="0,0,0,8"/>
                        <ItemsControl x:Name="ExtensionGroupsList"
                                      ItemsSource="{Binding ExtensionGroups}"
                                      Margin="0,0,0,16">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <!-- One collapsible category; collapsed by default.
                                         Native Expander: WPF-UI 4.x ships no generic Expander
                                         control, and ControlsDictionary restyles this one. -->
                                    <Expander Margin="0,0,0,6">
                                        <Expander.Header>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding Extensions.Count, StringFormat=' ({0})'}"
                                                           VerticalAlignment="Center" Opacity="0.6"/>
                                            </StackPanel>
                                        </Expander.Header>
                                        <!-- StackPanel (not WrapPanel): a WrapPanel would measure
                                             its children with infinite width, so the inner
                                             checkbox WrapPanel would never wrap. -->
                                        <StackPanel Margin="4,2">
                                            <ItemsControl ItemsSource="{Binding Extensions}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <CheckBox Content="{Binding Extension}"
                                                                  IsChecked="{Binding IsSelected}"
                                                                  Margin="0,0,12,4"/>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <!-- Trailing add button: opens the custom-extension dialog. -->
                                            <Button Content="＋ 添加扩展名"
                                                    Command="{Binding DataContext.AddExtensionCommand, ElementName=ExtensionGroupsList}"
                                                    CommandParameter="{Binding}"
                                                    HorizontalAlignment="Left"
                                                    Margin="0,2,0,4" Padding="8,2" FontSize="12"/>
                                        </StackPanel>
                                    </Expander>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <ui:Button Content="扫描预览 →" Appearance="Primary"
                                   Command="{Binding ScanCommand}" Padding="24,8"
                                   HorizontalAlignment="Left"/>
                    </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- Tab 2: File List -->
                <TabItem Header="② 文件列表">
                    <DockPanel Margin="8">
                        <TextBlock DockPanel.Dock="Top"
                                   Text="{Binding FileItems.Count, StringFormat='已扫描 {0} 个文件'}"
                                   Margin="0,0,0,8" Opacity="0.7"/>

                        <ui:Button DockPanel.Dock="Bottom" Content="执行转换 →" Appearance="Primary"
                                   Command="{Binding ConvertCommand}" Padding="24,8"
                                   HorizontalAlignment="Right" Margin="0,8,0,0"/>

                        <DataGrid ItemsSource="{Binding FileItems}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  IsReadOnly="False"
                                  GridLinesVisibility="Horizontal"
                                  HeadersVisibility="Column">
                            <DataGrid.Columns>
                                <DataGridCheckBoxColumn Header="选择" Binding="{Binding IsSelected}"
                                                         Width="50"/>
                                <DataGridTextColumn Header="文件路径" Binding="{Binding RelativePath}"
                                                    Width="2*" IsReadOnly="True"/>
                                <DataGridTextColumn Header="大小" Binding="{Binding FileSize}"
                                                    Width="80" IsReadOnly="True"/>
                                <DataGridTextColumn Header="检测编码" Binding="{Binding DetectedEncoding}"
                                                    Width="100" IsReadOnly="True"/>
                                <DataGridTextColumn Header="目标编码" Binding="{Binding TargetEncoding}"
                                                    Width="100" IsReadOnly="True"/>
                                <DataGridTextColumn Header="状态" Binding="{Binding Status}"
                                                    Width="80" IsReadOnly="True"/>
                                <DataGridTextColumn Header="详情" Binding="{Binding StatusMessage}"
                                                    Width="*" IsReadOnly="True"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </TabItem>

                <!-- Tab 3: Conversion -->
                <TabItem Header="③ 转换">
                    <StackPanel Margin="8" VerticalAlignment="Center">
                        <ProgressBar Value="{Binding ProgressValue}"
                                     Maximum="{Binding ProgressMaximum}"
                                     Height="24" Margin="0,0,0,8"/>
                        <TextBlock HorizontalAlignment="Center" Margin="0,0,0,16">
                            <Run Text="{Binding ProgressValue}"/>
                            <Run Text="/"/>
                            <Run Text="{Binding ProgressMaximum}"/>
                        </TextBlock>
                        <TextBlock Text="{Binding CurrentFileName}"
                                   HorizontalAlignment="Center" Opacity="0.6"
                                   TextTrimming="CharacterEllipsis" Margin="0,0,0,24"/>
                        <ui:Button Content="取消转换" Appearance="Danger"
                                   Command="{Binding CancelCommand}"
                                   HorizontalAlignment="Center" Padding="24,8"/>
                    </StackPanel>
                </TabItem>

                <!-- Tab 4: Report -->
                <TabItem Header="④ 报告">
                    <!-- The file lists inside the sections can get long: scroll the whole tab. -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="8" Padding="0,0,12,0">
                    <StackPanel VerticalAlignment="Top">
                        <TextBlock Text="转换完成" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,16"/>

                        <TextBlock Text="点击下方各项可展开查看具体文件"
                                   FontSize="11" Opacity="0.6" Margin="0,0,0,8"/>
                        <ItemsControl ItemsSource="{Binding ReportSections}" Margin="0,0,0,16">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Expander IsExpanded="{Binding IsExpanded, Mode=TwoWay}"
                                              Margin="0,0,0,6">
                                        <Expander.Header>
                                            <TextBlock VerticalAlignment="Center">
                                                <Run Text="{Binding Icon, Mode=OneWay}"/>
                                                <Run Text=" "/>
                                                <Run Text="{Binding Title, Mode=OneWay}"/>
                                                <Run Text=": "/>
                                                <Run Text="{Binding Count, Mode=OneWay}"/>
                                                <Run Text=" 个文件"/>
                                            </TextBlock>
                                        </Expander.Header>
                                        <ItemsControl ItemsSource="{Binding Files}" Margin="4,2">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding}" FontSize="12"
                                                               Margin="0,1" TextWrapping="Wrap"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Expander>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="输出目录:" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <DockPanel Margin="0,0,0,24">
                            <ui:Button DockPanel.Dock="Right" Content="打开文件夹" Margin="8,0,0,0"
                                       Command="{Binding OpenOutputFolderCommand}" Padding="12,4"/>
                            <ui:TextBox Text="{Binding Summary.OutputPath}" IsReadOnly="True"/>
                        </DockPanel>

                        <StackPanel Orientation="Horizontal">
                            <ui:Button Content="重新扫描" Command="{Binding ResetCommand}"
                                       Padding="16,4" Margin="0,0,8,0"/>
                            <ui:Button Content="选择新文件夹" Command="{Binding BrowseFolderCommand}"
                                       Padding="16,4"/>
                        </StackPanel>
                    </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>

            <!-- Bottom-right corner below the tabs (own row: never overlaps content) -->
            <StackPanel Grid.Row="2" Orientation="Horizontal"
                        HorizontalAlignment="Right" VerticalAlignment="Center"
                        Margin="0,8,0,0">
                <ui:Button Content="🔄" ToolTip="检查更新"
                           Command="{Binding CheckForUpdatesCommand}"
                           Padding="10,6" FontSize="14" Margin="0,0,8,0"/>
                <ui:Button Content="{Binding ThemeIcon}"
                           ToolTip="切换浅色 / 深色模式"
                           Click="ThemeToggleButton_Click"
                           Padding="10,6" FontSize="14"/>
            </StackPanel>
        </Grid>
    </Grid>
</ui:FluentWindow>
