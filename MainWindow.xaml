<ui:FluentWindow x:Class="Encodex.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:r="clr-namespace:Encodex.Resources"
        Title="{x:Static r:Res.Ui_Title}"
        Icon="pack://application:,,,/Ico/encodex.ico"
        ExtendsContentIntoTitleBar="True"
        Height="650" Width="950"
        WindowStartupLocation="CenterScreen"
        AllowDrop="True" Drop="Window_Drop">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Custom title bar: app icon + name on the left, window buttons on the right.
             Icon uses a PNG: WPF ImageSource cannot decode .ico files (Window.Icon is
             the only .ico-capable path). -->
        <ui:TitleBar Grid.Row="0"
                     Title="{x:Static r:Res.Ui_Title}"
                     Icon="pack://application:,,,/Ico/encodex.png"
                     ShowMinimize="True" ShowMaximize="True" ShowClose="True"
                     CloseWindowByDoubleClickOnIcon="True"/>

        <Grid Grid.Row="1" Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Status Bar -->
            <TextBlock Grid.Row="0" Text="{Binding StatusText}" Margin="0,0,0,8"
                       FontSize="14" Opacity="0.8"/>

            <!-- Tab Control -->
            <TabControl Grid.Row="1" SelectedIndex="{Binding SelectedTabIndex}">

                <!-- Tab 1: Configuration -->
                <TabItem Header="{x:Static r:Res.Ui_TabConfig}">
                    <!-- ScrollViewer: the form can exceed the window height (small windows / high DPI).
                         Right padding keeps the scrollbar clear of the form controls. -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="8,8,4,8" Padding="0,0,12,0">
                    <StackPanel VerticalAlignment="Top">
                        <TextBlock Text="{x:Static r:Res.Ui_SourceFolder}" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <DockPanel Margin="0,0,0,16">
                            <Button DockPanel.Dock="Right" Content="{x:Static r:Res.Ui_Browse}" Margin="8,0,0,0"
                                    Command="{Binding BrowseFolderCommand}" Padding="16,4"/>
                            <ui:TextBox Text="{Binding SourceFolderPath, UpdateSourceTrigger=PropertyChanged}"
                                        IsReadOnly="True"/>
                        </DockPanel>

                        <TextBlock Text="{x:Static r:Res.Ui_TargetEncoding}" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <ComboBox ItemsSource="{Binding AvailableEncodings}"
                                  SelectedItem="{Binding SelectedEncoding}"
                                  DisplayMemberPath="DisplayName"
                                  Margin="0,0,0,8" Padding="8"/>

                        <CheckBox Content="{x:Static r:Res.Ui_OverwriteInPlace}"
                                  IsChecked="{Binding IsOverwriteInPlace}"
                                  Margin="0,0,0,16"/>

                        <TextBlock Text="{x:Static r:Res.Ui_FileExtensions}" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <TextBlock Text="{x:Static r:Res.Ui_ExtensionsHint}"
                                   FontSize="11" Opacity="0.6" Margin="0,0,0,8"/>
                        <ItemsControl x:Name="ExtensionGroupsList"
                                      ItemsSource="{Binding ExtensionGroups}"
                                      Margin="0,0,0,16">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <!-- One collapsible category; collapsed by default.
                                         Native Expander: WPF-UI 4.x ships no generic Expander
                                         control, and ControlsDictionary restyles this one. -->
                                    <Expander Margin="0,0,0,6">
                                        <Expander.Header>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding Extensions.Count, StringFormat=' ({0})'}"
                                                           VerticalAlignment="Center" Opacity="0.6"/>
                                            </StackPanel>
                                        </Expander.Header>
                                        <!-- StackPanel (not WrapPanel): a WrapPanel would measure
                                             its children with infinite width, so the inner
                                             checkbox WrapPanel would never wrap. -->
                                        <StackPanel Margin="4,2">
                                            <ItemsControl ItemsSource="{Binding Extensions}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <CheckBox Content="{Binding Extension}"
                                                                  IsChecked="{Binding IsSelected}"
                                                                  Margin="0,0,12,4"/>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <!-- Trailing add button: opens the custom-extension dialog. -->
                                            <Button Content="{x:Static r:Res.Ui_AddExtension}"
                                                    Command="{Binding DataContext.AddExtensionCommand, ElementName=ExtensionGroupsList}"
                                                    CommandParameter="{Binding}"
                                                    HorizontalAlignment="Left"
                                                    Margin="0,2,0,4" Padding="8,2" FontSize="12"/>
                                        </StackPanel>
                                    </Expander>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <ui:Button Content="{x:Static r:Res.Ui_Scan}" Appearance="Primary"
                                   Command="{Binding ScanCommand}" Padding="24,8"
                                   HorizontalAlignment="Left"/>
                    </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- Tab 2: File List -->
                <TabItem Header="{x:Static r:Res.Ui_TabFiles}">
                    <DockPanel Margin="8">
                        <TextBlock DockPanel.Dock="Top"
                                   Text="{Binding ScannedCountText}"
                                   Margin="0,0,0,8" Opacity="0.7"/>

                        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                                    HorizontalAlignment="Right" Margin="0,8,0,0">
                            <ui:Button Content="{x:Static r:Res.Ui_PreviewSelected}" Command="{Binding PreviewSelectedCommand}"
                                       Padding="16,8" Margin="0,0,8,0"/>
                            <ui:Button Content="{x:Static r:Res.Ui_Convert}" Appearance="Primary"
                                       Command="{Binding ConvertCommand}" Padding="24,8"/>
                        </StackPanel>

                        <DataGrid ItemsSource="{Binding FileItems}"
                                  SelectedItem="{Binding SelectedFileItem}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  IsReadOnly="False"
                                  GridLinesVisibility="Horizontal"
                                  HeadersVisibility="Column">
                            <DataGrid.Columns>
                                <DataGridCheckBoxColumn Header="{x:Static r:Res.Ui_Select}" Binding="{Binding IsSelected}"
                                                         Width="50"/>
                                <DataGridTextColumn Header="{x:Static r:Res.Ui_FilePath}" Binding="{Binding RelativePath}"
                                                    Width="2*" IsReadOnly="True"/>
                                <DataGridTextColumn Header="{x:Static r:Res.Ui_Size}" Binding="{Binding FileSize}"
                                                    Width="80" IsReadOnly="True"/>
                                <DataGridTemplateColumn Header="{x:Static r:Res.Ui_DetectedEncoding}" Width="110">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding DetectedEncoding}" VerticalAlignment="Center"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                    <DataGridTemplateColumn.CellEditingTemplate>
                                        <DataTemplate>
                                            <ComboBox ItemsSource="{Binding DataContext.AvailableDetectedEncodings, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                      SelectedItem="{Binding DetectedEncoding, UpdateSourceTrigger=PropertyChanged}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellEditingTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="{x:Static r:Res.Ui_TargetEncodingCol}" Binding="{Binding TargetEncoding}"
                                                    Width="100" IsReadOnly="True"/>
                                <DataGridTextColumn Header="{x:Static r:Res.Ui_Status}" Binding="{Binding Status}"
                                                    Width="80" IsReadOnly="True"/>
                                <DataGridTextColumn Header="{x:Static r:Res.Ui_Details}" Binding="{Binding StatusMessage}"
                                                    Width="*" IsReadOnly="True"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </TabItem>

                <!-- Tab 3: Conversion -->
                <TabItem Header="{x:Static r:Res.Ui_TabConvert}">
                    <StackPanel Margin="8" VerticalAlignment="Center">
                        <ProgressBar Value="{Binding ProgressValue}"
                                     Maximum="{Binding ProgressMaximum}"
                                     Height="24" Margin="0,0,0,8"/>
                        <TextBlock HorizontalAlignment="Center" Margin="0,0,0,16">
                            <Run Text="{Binding ProgressValue}"/>
                            <Run Text="/"/>
                            <Run Text="{Binding ProgressMaximum}"/>
                        </TextBlock>
                        <TextBlock Text="{Binding CurrentFileName}"
                                   HorizontalAlignment="Center" Opacity="0.6"
                                   TextTrimming="CharacterEllipsis" Margin="0,0,0,24"/>
                        <ui:Button Content="{x:Static r:Res.Ui_CancelConvert}" Appearance="Danger"
                                   Command="{Binding CancelCommand}"
                                   HorizontalAlignment="Center" Padding="24,8"/>
                    </StackPanel>
                </TabItem>

                <!-- Tab 4: Report -->
                <TabItem Header="{x:Static r:Res.Ui_TabReport}">
                    <!-- The file lists inside the sections can get long: scroll the whole tab. -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="8" Padding="0,0,12,0">
                    <StackPanel VerticalAlignment="Top">
                        <TextBlock Text="{x:Static r:Res.Ui_ReportTitle}" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,16"/>

                        <TextBlock Text="{x:Static r:Res.Ui_ReportHint}"
                                   FontSize="11" Opacity="0.6" Margin="0,0,0,8"/>
                        <ItemsControl ItemsSource="{Binding ReportSections}" Margin="0,0,0,16">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Expander IsExpanded="{Binding IsExpanded, Mode=TwoWay}"
                                              Margin="0,0,0,6">
                                        <Expander.Header>
                                            <TextBlock VerticalAlignment="Center">
                                                <Run Text="{Binding Icon, Mode=OneWay}"/>
                                                <Run Text=" "/>
                                                <Run Text="{Binding Title, Mode=OneWay}"/>
                                                <Run Text=": "/>
                                                <Run Text="{Binding CountText, Mode=OneWay}"/>
                                            </TextBlock>
                                        </Expander.Header>
                                        <ItemsControl ItemsSource="{Binding Files}" Margin="4,2">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding}" FontSize="12"
                                                               Margin="0,1" TextWrapping="Wrap"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Expander>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="{Binding BackupDirectoryText}" TextWrapping="Wrap" Margin="0,0,0,8">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#C8A415"/>
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding BackupDirectoryText}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <TextBlock Text="{x:Static r:Res.Ui_OutputDir}" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <DockPanel Margin="0,0,0,24">
                            <ui:Button DockPanel.Dock="Right" Content="{x:Static r:Res.Ui_OpenFolder}" Margin="8,0,0,0"
                                       Command="{Binding OpenOutputFolderCommand}" Padding="12,4"/>
                            <ui:TextBox Text="{Binding Summary.OutputPath}" IsReadOnly="True"/>
                        </DockPanel>

                        <StackPanel Orientation="Horizontal">
                            <ui:Button Content="{x:Static r:Res.Ui_Rescan}" Command="{Binding ResetCommand}"
                                       Padding="16,4" Margin="0,0,8,0"/>
                            <ui:Button Content="{x:Static r:Res.Ui_SelectNewFolder}" Command="{Binding BrowseFolderCommand}"
                                       Padding="16,4"/>
                        </StackPanel>
                    </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>

            <!-- Bottom-right corner below the tabs (own row: never overlaps content) -->
            <StackPanel Grid.Row="2" Orientation="Horizontal"
                        HorizontalAlignment="Right" VerticalAlignment="Center"
                        Margin="0,8,0,0">
                <ui:Button Content="{x:Static r:Res.Ui_CheckUpdate}" ToolTip="{x:Static r:Res.Ui_CheckUpdateTooltip}"
                           Command="{Binding CheckForUpdatesCommand}"
                           Padding="10,6" FontSize="14" Margin="0,0,8,0"/>
                <ui:Button Content="{Binding ThemeIcon}"
                           ToolTip="{x:Static r:Res.Ui_ThemeTooltip}"
                           Command="{Binding ToggleThemeCommand}"
                           Padding="10,6" FontSize="14"/>
            </StackPanel>
        </Grid>
    </Grid>
</ui:FluentWindow>
